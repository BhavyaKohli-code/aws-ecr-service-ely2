{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ely",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ely"
  },
  "runtimes": [
    {
      "name": "ely",
      "description": "ELY enterprise employee assistant (HR / Sales knowledge via AgentCore Gateway)",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ely/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "mistral.ministral-3-8b-instruct"
        },
        {
          "name": "PRESIGNED_URL_EXPIRY_SECONDS",
          "value": "900"
        },
        {
          "name": "MAX_SOURCES",
          "value": "3"
        }
      ],
      "requestHeaderAllowlist": ["Authorization"],
      "additionalPolicies": ["policies/documents-read.json"],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_i4q7zoJr3/.well-known/openid-configuration",
          "allowedClients": ["29v9nta55qtfsbgrupp841900q"]
        }
      }
    }
  ],
  "memories": [
    {
      "name": "elyMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "kb-gateway",
      "description": "ELY knowledge retrieval tools (HR, Sales) with access policies by Cognito group",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_i4q7zoJr3/.well-known/openid-configuration",
          "allowedClients": ["29v9nta55qtfsbgrupp841900q"]
        }
      },
      "enableSemanticSearch": false,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "elyPolicyEngine",
        "mode": "LOG_ONLY"
      },
      "targets": [
        {
          "name": "hr-knowledge-retrieval",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-south-1:789270642392:function:new-ely2-poc-bhavya-retrievehr",
            "toolSchemaFile": "gateway/hr-knowledge-retrieval.tools.json"
          }
        },
        {
          "name": "sales-knowledge-retrieval",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:ap-south-1:789270642392:function:new-ely2-poc-bhavya-retrievesales",
            "toolSchemaFile": "gateway/sales-knowledge-retrieval.tools.json"
          }
        }
      ]
    }
  ],
  "policyEngines": [
    {
      "name": "elyPolicyEngine",
      "description": "ELY tool access: HR for FULL_TIME only, Sales for FULL_TIME and BUSINESS_PARTNER",
      "policies": []
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
