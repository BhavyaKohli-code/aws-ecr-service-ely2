{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKnowledgeBaseDocumentsForPresignedLinks",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::*/*",
